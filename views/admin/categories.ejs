<%- include('../partials/admin_head') %>
<h1>Категории и разделы</h1>
<% cats.forEach(function (c) { %><section class="card"><div class="card-h"><form method="post" action="/admin/categories/<%= c.id %>" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="title" value="<%= c.title %>" maxlength="80" style="min-width:220px"><input type="number" name="position" value="<%= c.position %>" style="width:80px" aria-label="Порядок"><button class="btn sm">Сохранить</button></form>
<form method="post" action="/admin/categories/<%= c.id %>" data-confirm="Удалить категорию «<%= c.title %>» вместе со всеми разделами и темами?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="delete"><button class="btn sm danger">Удалить</button></form></div>
<% c.sections.forEach(function (s) { %><details class="pad" style="border-top:1px solid var(--line)"><summary><%= s.icon %> <b><%= s.title %></b> <span class="muted small">просмотр от <%= s.view_min %> · ответы от <%= s.post_min %> · темы от <%= s.thread_min %></span></summary>
<form method="post" action="/admin/sections/<%= s.id %>" class="stack" style="margin-top:10px"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="inl"><input name="icon" value="<%= s.icon %>" style="max-width:70px"><input name="title" value="<%= s.title %>" style="max-width:260px"><input type="number" name="position" value="<%= s.position %>" style="width:80px"><select name="category_id" style="width:auto"><% cats.forEach(function (x) { %><option value="<%= x.id %>" <%= x.id === s.category_id ? 'selected' : '' %>><%= x.title %></option><% }) %></select></div>
<input name="description" value="<%= s.description %>" maxlength="200" placeholder="Описание">
<div class="inl muted small">Минимальный приоритет роли: просмотр <input type="number" name="view_min" value="<%= s.view_min %>" min="0" max="99" style="width:70px"> ответы <input type="number" name="post_min" value="<%= s.post_min %>" min="0" max="99" style="width:70px"> новые темы <input type="number" name="thread_min" value="<%= s.thread_min %>" min="0" max="99" style="width:70px"> <label class="inline"><input type="checkbox" name="solvable" <%= s.solvable ? 'checked' : '' %>> Темы можно отмечать «решено»</label></div>
<div class="inl"><button class="btn sm">Сохранить раздел</button></div></form>
<form method="post" action="/admin/sections/<%= s.id %>" data-confirm="Удалить раздел «<%= s.title %>» со всеми темами?" style="margin-top:6px"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="delete"><button class="btn sm danger">Удалить раздел</button></form></details><% }) %></section><% }) %>
<div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(300px,1fr))">
<section class="card pad"><h3>Новая категория</h3><form method="post" action="/admin/categories/new" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><input name="title" placeholder="Название" required maxlength="80"><input type="number" name="position" placeholder="Порядок" value="99"><div><button class="btn sm">Создать</button></div></form></section>
<section class="card pad"><h3>Новый раздел</h3><form method="post" action="/admin/sections/new" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><select name="category_id"><% cats.forEach(function (c) { %><option value="<%= c.id %>"><%= c.title %></option><% }) %></select><div class="inl"><input name="icon" placeholder="💬" style="max-width:70px"><input name="title" placeholder="Название" required maxlength="80" style="flex:1"></div><input name="description" placeholder="Описание" maxlength="200"><div><button class="btn sm">Создать</button></div></form>
<p class="muted small">Приоритеты ролей: <% roles.forEach(function (r) { %><%= r.name %> = <%= r.priority %>; <% }) %></p></section></div>
<%- include('../partials/admin_foot') %>

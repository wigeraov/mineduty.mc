<%- include('../partials/admin_head') %>
<h1><%- nick(u.username, u.roles[0]) %> <a class="btn sec sm" href="/u/<%= encodeURIComponent(u.username) %>">Профиль</a></h1>
<div class="muted small"><%= can('user.manage') ? u.email + ' · ' : '' %>регистрация <%= fmtDate(u.created_at) %> · сообщений <%= u.post_count %> · email <%= u.email_verified ? 'подтверждён' : 'не подтверждён' %></div>
<% if (!manageable) { %><div class="flash err" style="margin-top:10px">Это ваш аккаунт или пользователь с равной/более высокой ролью — санкции и роли недоступны.</div><% } %>
<% if (manageable) { %>
<% if (can('role.assign')) { %><section class="card pad"><h3>Роли</h3><div class="inl"><% u.roles.forEach(function (r) { %><form method="post" action="/admin/users/<%= u.id %>/role" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="remove"><input type="hidden" name="role_id" value="<%= r.id %>"><%- badge(r) %><button class="btn sm sec" title="Снять роль">✕</button></form><% }) %></div>
<form method="post" action="/admin/users/<%= u.id %>/role" class="inl" style="margin-top:10px" data-confirm="Назначить выбранную роль?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="add"><select name="role_id" style="width:auto"><% allRoles.forEach(function (r) { if (!u.roles.some(function (x) { return x.id === r.id; }) && (can('role.manage') || r.priority < me.priority)) { %><option value="<%= r.id %>"><%= r.name %></option><% } }) %></select><button class="btn sm">Назначить</button></form></section><% } %>
<section class="card pad"><h3>Санкции</h3><div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr))">
<% if (can('warn.issue')) { %><form method="post" action="/admin/users/<%= u.id %>/warn" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>"><b>Предупреждение</b><input name="reason" placeholder="Причина" required minlength="5" maxlength="300"><button class="btn sm">Выдать</button></form><% } %>
<% if (can('user.mute')) { %><form method="post" action="/admin/users/<%= u.id %>/mute" class="stack" data-confirm="Выдать мут пользователю <%= u.username %>?"><input type="hidden" name="_csrf" value="<%= csrf %>"><b>Мут</b><input name="reason" placeholder="Причина" required minlength="5" maxlength="300"><select name="duration"><option value="1h">1 час</option><option value="1d">1 день</option><option value="7d">7 дней</option><option value="30d">30 дней</option></select><button class="btn sm">Выдать мут</button></form><% } %>
<% if (can('user.ban')) { %><form method="post" action="/admin/users/<%= u.id %>/ban" class="stack" data-confirm="Заблокировать аккаунт <%= u.username %>? Все его сессии будут завершены."><input type="hidden" name="_csrf" value="<%= csrf %>"><b>Блокировка</b><input name="reason" placeholder="Причина" required minlength="5" maxlength="300"><select name="duration"><option value="1d">1 день</option><option value="7d">7 дней</option><option value="30d">30 дней</option><option value="perm">Навсегда</option></select><button class="btn sm danger">Заблокировать</button></form><% } %></div></section>
<% } %>
<section class="card"><h2>История санкций</h2><div class="tbl"><table><tbody>
<% bans.forEach(function (b) { var live = b.active && (!b.expires_at || b.expires_at > Date.now()); %><tr><td><%= b.type === 'ban' ? '⛔ Бан' : '🔇 Мут' %></td><td><%= b.reason %><div class="muted small"><%= b.issuer %> · <%= fmtDate(b.created_at) %> · до <%= b.expires_at ? fmtDate(b.expires_at) : 'бессрочно' %></div></td>
<td><% if (live && can(b.type === 'ban' ? 'user.ban' : 'user.mute')) { %><form method="post" action="/admin/sanctions/<%= b.id %>/revoke" data-confirm="Снять санкцию?"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="back" value="/admin/users/<%= u.id %>"><button class="btn sm sec">Снять</button></form><% } else { %><span class="muted"><%= live ? 'действует' : 'завершена' %></span><% } %></td></tr><% }) %>
<% warnings.forEach(function (w) { %><tr><td>⚠️ Предупр.</td><td><%= w.reason %><div class="muted small"><%= w.issuer %> · <%= fmtDate(w.created_at) %></div></td><td></td></tr><% }) %>
<% if (!bans.length && !warnings.length) { %><tr><td class="muted">Нарушений нет</td></tr><% } %></tbody></table></div></section>
<%- include('../partials/admin_foot') %>

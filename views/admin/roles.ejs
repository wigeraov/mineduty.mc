<%- include('../partials/admin_head') %>
<h1>Роли и цвета никнеймов</h1><p class="muted">Изменения сразу видны во всех сообщениях, профилях и списках. Роль с наибольшим приоритетом определяет цвет ника.</p>
<% roles.forEach(function (r) { var locked = r.key === 'founder'; %>
<section class="card pad"><form method="post" action="/admin/roles/<%= r.id %>" class="stack"><input type="hidden" name="_csrf" value="<%= csrf %>">
<div class="inl"><%- badge(r) %> <b style="color:<%= r.color %>"><%= r.name %></b><span class="muted small">ключ: <%= r.key %> · участников: <%= r.members %></span></div>
<div class="inl"><input name="name" value="<%= r.name %>" maxlength="30" required style="max-width:200px" aria-label="Название"><input type="color" name="color" value="<%= r.color %>" aria-label="Цвет"><input name="icon" value="<%= r.icon %>" maxlength="8" style="max-width:70px" aria-label="Иконка">
<label class="inline">Приоритет <input type="number" name="priority" value="<%= r.priority %>" min="1" max="99" style="width:80px" <%= locked ? 'readonly' : '' %>></label><label class="inline"><input type="checkbox" name="is_staff" <%= r.is_staff ? 'checked' : '' %>> Персонал</label></div>
<details><summary class="muted">Права доступа (<%= r.perms.size %>)<%= locked ? ' — у основателя неизменны' : '' %></summary><div class="perms" style="margin-top:8px"><% Object.keys(PERMS).forEach(function (k) { %><label class="inline"><input type="checkbox" name="perms" value="<%= k %>" <%= r.perms.has(k) ? 'checked' : '' %> <%= locked ? 'disabled' : '' %>> <%= PERMS[k] %></label><% }) %></div></details>
<div class="inl"><button class="btn sm">Сохранить</button></div></form>
<% if (!['user', 'founder'].includes(r.key)) { %><form method="post" action="/admin/roles/<%= r.id %>" data-confirm="Удалить роль «<%= r.name %>»? Её участники станут обычными пользователями."><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="delete"><button class="btn sm danger">Удалить роль</button></form><% } %></section><% }) %>
<section class="card pad"><h3>Новая группа</h3><p class="muted small">Например: куратор, заместитель основателя, следящий администратор.</p><form method="post" action="/admin/roles/new" class="inl"><input type="hidden" name="_csrf" value="<%= csrf %>">
<input name="key" placeholder="ключ (latin)" pattern="[a-z0-9_]{2,20}" required style="max-width:140px"><input name="name" placeholder="Название" required maxlength="30" style="max-width:180px"><input type="color" name="color" value="#a78bfa"><input name="icon" placeholder="🔰" maxlength="8" style="max-width:70px"><input type="number" name="priority" placeholder="Приоритет" min="1" max="99" required style="width:110px"><label class="inline"><input type="checkbox" name="is_staff"> Персонал</label><button class="btn sm">Создать</button></form></section>
<%- include('../partials/admin_foot') %>
